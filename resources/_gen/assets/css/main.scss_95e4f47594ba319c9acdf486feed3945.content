*{box-sizing:border-box}html{line-height:1.6}body{margin:0;font-family:sans-serif;background:#3d3d3d;color:#bd4f00}h1,h2,h3,h4,h5,h6{color:#d76b0d}a{color:#fff;transition:color .35s;text-decoration:none}a:hover{color:#d76b0d}code{font-family:monospace,monospace;font-size:1em;color:rgba(189,79,0,.8);text-size-adjust:100%;-ms-text-size-adjust:100%;-moz-text-size-adjust:100%;-webkit-text-size-adjust:100%}pre{font-size:1rem;line-height:1.2em;margin:0;overflow:auto}pre code{font-size:.8em}::selection{background:rgba(189,79,0,.25)}::-moz-selection{background:rgba(189,79,0,.25)}.app-header{padding:2.5em;background:#161616;text-align:center}.app-header-avatar{width:15rem;height:15rem;border-radius:100%;border:.5rem solid #fff}.app-container{padding:2.5rem}.app-header-social{display:flex;align-items:center;justify-content:center;font-size:2em;color:#d76b0d}.app-header-social a:not(:last-child){margin-right:.4em}.app-header-title{color:#d76b0d;display:block;font-size:2em;margin:.67em 0;font-weight:700}@media(min-width:940px){.app-header{position:fixed;top:0;left:0;width:20rem;min-height:100vh}.app-container{max-width:65rem;margin-left:20rem}}.error-404{text-align:center}.error-404-title{text-transform:uppercase}.icon{display:inline-block;width:1em;height:1em;margin-top:-.125em}.pagination{display:block;list-style:none;padding:0;font-size:.8em;text-align:center;margin:3em 0}.page-item{display:inline-block}.page-item .page-link{display:flex;align-items:center;justify-content:center;width:1.8rem;height:1.8rem}.page-item.active .page-link{color:#d76b0d;border-radius:2em;background:#fff}.post-title{color:#d76b0d}.post-meta>div{display:flex;align-items:center;flex-wrap:wrap;gap:.2em;font-size:.8em}.post-meta>div>.icon{margin-right:.4em}.post-content>pre,.post-content .highlight{margin:1em 0}.post-content>pre,.post-content .highlight>pre,.post-content .highlight>div{border-left:.4em solid rgba(255,255,255,.8);padding:1em}.post-content blockquote{border-left:.4em solid rgba(255,255,255,.8);margin:1em 0;padding:.5em 1em;background:#161616}.post-content blockquote p{margin:.5em 0}.post-content img{max-width:100%}.posts-list{padding:0}.posts-list-item{list-style:none;padding:.4em 0}.posts-list-item:not(:last-child){border-bottom:1px dashed rgba(255,255,255,.3)}.posts-list-item-description{display:flex;align-items:center;font-size:.8em}.posts-list-item-description>.icon{margin-right:.4em}.posts-list-item-separator{margin:0 .4em}.tag{display:inline-block;margin-right:.2em;padding:0 .6em;font-size:.9em;border-radius:.2em;white-space:nowrap;background:rgba(255,255,255,.1);transition:color .35s,background .35s}.tag:hover{transition:color .25s,background .05s;background:rgba(255,255,255,.3)}.tags-list{padding:0}.tags-list-item{display:flex;align-items:center;list-style:none;padding:.4em 0}.tags-list-item>.icon{margin-right:.4em}.tags-list-item:not(:last-child){border-bottom:1px dashed rgba(255,255,255,.3)}@media(min-width:450px){.tags-list{display:flex;flex-wrap:wrap}.tags-list-item{width:calc(50% - 1em)}.tags-list-item:nth-child(even){margin-left:1em}.tags-list-item:nth-last-child(2){border:none}}@font-face{font-family:zain;src:url(/fonts/Zain-Regular.ttf)format("truetype");font-weight:400;font-style:normal}@font-face{font-family:zain;src:url(/fonts/Zain-Bold.ttf)format("truetype");font-weight:700;font-style:normal}@font-face{font-family:zain;src:url(/fonts/Zain-Italic.ttf)format("truetype");font-weight:400;font-style:italic}.gallery-row{display:flex;flex-wrap:wrap;padding:0 4px;justify-content:center;gap:10px;margin-top:20px}.gallery-column{flex:25%;max-width:25%;padding:0 4px}@media screen and (max-width:800px){.gallery-column{flex:50%;max-width:50%}}@media screen and (max-width:600px){.gallery-column{flex:100%;max-width:100%}}.gallery-column img{margin-top:8px;vertical-align:middle;width:100%;max-width:250px;border-radius:4px;cursor:pointer;transition:transform .2s ease,opacity .2s ease}.gallery-column img:hover{transform:scale(1.02);opacity:.85}.lightbox-overlay{display:none;position:fixed;z-index:999;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,.85);justify-content:center;align-items:center;backdrop-filter:blur(2px)}.lightbox-overlay.active{display:flex}.lightbox-overlay img{max-width:90%;max-height:90%;border-radius:6px;box-shadow:0 0 20px #000;z-index:2}.lightbox-arrow{position:absolute;top:50%;font-size:3em;color:#d76b0d;cursor:pointer;padding:10px;transform:translateY(-50%);user-select:none;transition:color .2s ease}.lightbox-arrow.left{left:20px}.lightbox-arrow.right{right:20px}.lightbox-arrow:hover{color:rgba(215,107,13,.7)}.lightbox-close{position:absolute;top:20px;right:30px;font-size:2.5em;color:#d76b0d;cursor:pointer;user-select:none;z-index:3;transform:translateY(-50%);transition:color .2s ease}.lightbox-close:hover{color:rgba(215,107,13,.7)}.row{flex-wrap:wrap;display:flex;justify-content:center;gap:10px;margin-top:20px}.LD-item{flex:0 1 200px;display:flex;justify-content:center}.LD-img{opacity:1;cursor:pointer;width:100%;max-width:250px;aspect-ratio:16/10;height:auto;transition:opacity .2s ease}.LD-img:hover{opacity:.8}.LDcontainer{margin:20px auto;display:block;width:80%;max-width:900px}.LDcontainer img{width:100%;height:auto;border-radius:6px}.app-header{padding:4em;padding-left:4em;padding-top:1.5em;background:#fff}.app-header-avatar{transform:translate(-30px,0);width:17rem;height:10rem;border:0;border-radius:0%}.app-container{padding:2.5rem}.app-header-menu{margin-top:35px}.app-header-menu-item{display:block;margin:.05em;font-size:19px}.app-header-menu-secondary{display:block;margin-top:50px}.app-header-menu-secondary-item{margin:.2em;font-size:20px;color:#161616}.app-header-social{display:flex;align-items:center;justify-content:center;font-size:1.6em;color:#d76b0d}.app-header-social html,.app-header-social body{height:100%;margin:0;display:flex;flex-direction:column}.app-header-social a:not(:last-child){margin-right:.4em}.app-header-title{color:#d76b0d;display:block;font-size:.85em;margin:.1em 0;font-weight:700}@media(min-width:940px){.app-header{position:fixed;top:0;left:0;width:23rem;min-height:100vh}.app-container{max-width:75rem;margin-left:35rem;text-align:center;flex:1}.app-header-avatar{transform:translate(-35px,0);width:17rem;height:10rem}}body{margin:.5px;background:#fff;color:#3d3d3d;font-family:zain,sans-serif;font-size:1.4em}h1,h2,h3,h4,h5,h6{color:#d76b0d}h1{text-align:center}h2{text-align:left;font-size:1.8em;margin-bottom:.2em;line-height:1em}h2+p{text-align:left;margin-top:.2em}a{color:#3d3d3d;transition:color .35s;text-decoration:none}a:hover{color:#bd4f00}.post-footer{text-align:center;font-size:.9em;color:#d76b0d;padding:2em 0}.post-footer a{text-decoration:underline}.post-content{text-align:center}.post-content img{max-width:100%;transition:opacity .2s ease}.post-content img:hover{opacity:.8}.icon{display:inline-block;width:.8em;height:.8em;margin-top:1em}.post-title{color:#bd4f00;font-size:2.2em}.post-meta>div{display:flex;align-items:center;flex-wrap:wrap;gap:.2em;font-size:.8em}.post-meta>div>.icon{margin-right:.4em}.post-content{text-align:center}.post-content>pre,.post-content .highlight{margin:1em 0}.post-content>pre,.post-content .highlight>pre,.post-content .highlight>div{border-left:.4em solid rgba(255,255,255,.8);padding:1em}.post-content blockquote{border-left:.4em solid rgba(255,255,255,.8);margin:1em 0;padding:.5em 1em;background:#161616}.post-content blockquote p{margin:.5em 0}.post-content img{max-width:100%;transition:opacity .2s ease}*{box-sizing:border-box}p{line-height:1.1}html{height:100%;line-height:1.6}article{margin:0 auto}::selection{background:rgba(189,79,0,.25)}::-moz-selection{background:rgba(189,79,0,.25)}